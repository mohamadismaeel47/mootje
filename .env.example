# ---------------------------------------------------------------
# Recruitment CRM - configuration
# Copy to .env (or run: npm run setup:env) and fill in the values.
# NEVER commit the .env file. It contains secrets.
# ---------------------------------------------------------------

NODE_ENV=production
PORT=4000
# Public https address of this server (used to show the webhook URL), e.g. https://crm.example.com
PUBLIC_URL=

# PostgreSQL (local, Supabase, Neon, Railway, ...). For Supabase/hosted DBs set DATABASE_SSL=true
DATABASE_URL=postgres://crm:change-me@localhost:5432/recruitment_crm
DATABASE_SSL=false

# Random secrets - generated by "npm run setup:env"
JWT_SECRET=
# 64 hex characters. Encrypts WhatsApp tokens and BSN numbers. Make a backup: if you lose it, encrypted data is lost.
ENCRYPTION_KEY=

# Optional: required to create the first admin account through the website
SETUP_TOKEN=

# Folder for CV files (outside the web root)
# UPLOAD_DIR=/var/lib/recruitment-crm/uploads
MAX_UPLOAD_MB=10
SESSION_HOURS=12

# --- WhatsApp Business Cloud API (Meta) ---
# You can fill these here OR in the CRM settings page. Values here always win.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# --- Email (optional, to send candidates/CVs to agencies) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
